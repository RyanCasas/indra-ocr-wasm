{
  "name": "@ryancasas/indra-ocr-wasm",
  "version": "0.3.0",
  "description": "Indra OCR running locally in browser WebAssembly workers",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "indra-ocr-assets": "./scripts/assets.mjs"
  },
  "files": [
    "dist",
    "scripts/assets.mjs",
    "models.lock.json",
    "python/**/*.py",
    "vendor/indra/indra_ocr/**/*.py",
    "vendor/indra/REVISION",
    "vendor/indra/LICENSE",
    "assets/icon.svg",
    "CHANGELOG.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/assets.mjs",
    "fixtures": "python3 scripts/fixtures.py",
    "test:browser": "node scripts/browser-tests.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "release": "node scripts/release.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "onnxruntime-web": "1.30.0",
    "pyodide": "0.29.3"
  },
  "devDependencies": {
    "conventional-changelog-conventionalcommits": "10.4.1",
    "conventional-recommended-bump": "12.1.0",
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "semver": "7.7.4",
    "typescript": "5.9.3"
  },
  "author": "Ryan Casas",
  "keywords": [
    "ocr",
    "wasm",
    "webassembly",
    "browser",
    "pdf",
    "indra"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanCasas/indra-ocr-wasm.git"
  },
  "homepage": "https://github.com/RyanCasas/indra-ocr-wasm#readme",
  "bugs": {
    "url": "https://github.com/RyanCasas/indra-ocr-wasm/issues"
  }
}
